{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poe2-comparator",
  "version": "0.1.0",
  "identifier": "com.alexkjzz.poe2-comparator",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PoE2 Comparator",
        "width": 1200,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
